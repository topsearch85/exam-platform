# URL trang web (dùng trong email đặt lại mật khẩu)
FRONTEND_URL=http://localhost:3000

# Gửi email (nodemailer). Khi không cấu hình gửi được thư: NODE_ENV=development in link + devResetUrl.
#
# MAIL_TRANSPORT=smtp   (mặc định) — cần SMTP_HOST
# MAIL_TRANSPORT=sendmail — gọi binary sendmail (giống luồng thường dùng với PHP mail() + MTA), không dùng SMTP_HOST
#   Linux/macOS: thường để trống SENDMAIL_PATH → /usr/sbin/sendmail
#   Windows: bắt buộc SENDMAIL_PATH=... (ví dụ sendmail.exe trong XAMPP)
# SENDMAIL_PATH=
#
# --- Test local với Mailpit (Docker, khuyên dùng) ---
# Từ thư mục gốc exam-platform:  docker compose up -d mailpit
# Mở http://localhost:8025 để xem email. Backend dùng:
#   SMTP_HOST=127.0.0.1
#   SMTP_PORT=1025
#   SMTP_SECURE=false
#   MAIL_FROM=dev@localhost
# (Không cần SMTP_USER / SMTP_PASS.) Mẫu đầy đủ: backend/.env.mailpit.example
#
# --- SMTP thật (ví dụ nhà cung cấp) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Speaking Coach — Whisper self-host (MediaRecorder → backend → HTTP local). Không dùng OpenAI.
# Bắt buộc: URL đầy đủ tới endpoint transcribe (POST multipart giống OpenAI /v1/audio/transcriptions).
# Nếu để trống: API trả 503 "Chưa cấu hình LOCAL_WHISPER_HTTP_URL".
# Ví dụ whisper.cpp: ./server -p 9000 → dùng URL dưới; đổi host/port/path nếu server của bạn khác.
LOCAL_WHISPER_HTTP_URL=http://127.0.0.1:9000/v1/audio/transcriptions
WHISPER_LANGUAGE=en
LOCAL_WHISPER_MODEL=whisper-1
# LOCAL_WHISPER_HTTP_HEADERS={"Authorization":"Bearer ..."}

# MySQL — có thể ghi đè mặc định trong db.js (cần sửa db.js để đọc env nếu dùng)
# DB_HOST=localhost
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=exam_db
